# DocuLens — local environment template (SPECIFICATIONS.md §54, §70).
# Copy to `.env` (git-ignored) and adjust. Never put real secrets in this file.
#
# Variables are grouped by the configuration categories in §70. Only settings that the current
# code and the local docker compose stack consume are listed; each later phase adds its own
# group (authentication, AWS, LLM, embeddings, rate limits, quotas). Settings are validated at
# start-up: staging and production refuse LOG_FORMAT=console.

# ---- Application -------------------------------------------------------------------------
APP_ENV=local

# ---- Observability -----------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
# Header used to receive and return the request correlation ID.
REQUEST_ID_HEADER=X-Request-ID

# ---- API ---------------------------------------------------------------------------------
# Serve /docs and /openapi.json. Unset: enabled locally, disabled in staging and production.
API_DOCS_ENABLED=true
# Upper bound for each dependency probe run by /health/ready.
HEALTH_PROBE_TIMEOUT_SECONDS=2

# ---- Authentication (§8) ---------------------------------------------------------------
# HS256 signing key for access and refresh tokens: at least 32 random characters, unique per
# environment, stored in Secrets Manager when deployed. The placeholder below is not usable.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_ISSUER=doculens
JWT_AUDIENCE=doculens-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_MIN_LENGTH=12
# Authentication endpoints: requests allowed per client address (and per account for login)
# within one window (SPECIFICATIONS.md §37).
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ---- Database (docker/compose.yaml → postgres) ------------------------------------------
# POSTGRES_* configure the local container; DATABASE_URL is what the API and worker connect to.
# If port 5432 is unavailable on your machine, change POSTGRES_PORT and DATABASE_URL together.
POSTGRES_USER=doculens
POSTGRES_PASSWORD=doculens-local-only
POSTGRES_DB=doculens
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://doculens:doculens-local-only@localhost:5432/doculens
# Connection pool per process (small on purpose; Lambda multiplexing is ADR-012).
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
# Log every SQL statement (local only; rejected in staging and production).
DATABASE_ECHO=false
# Integration tests use a throwaway container by default; point them at an existing server instead:
# DOCULENS_TEST_DATABASE_URL=postgresql+asyncpg://doculens:doculens-local-only@localhost:5432/doculens

# ---- Redis (docker/compose.yaml → redis) -------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- Document ingestion (§10.2, §13, §53) --------------------------------------------------
# Upload limits; MAX_FILE_SIZE_MB must not exceed STORAGE_MAX_OBJECT_BYTES.
MAX_FILE_SIZE_MB=50
MAX_PAGES_PER_DOCUMENT=500
MAX_DOCUMENTS_PER_USER=100
# The parser runs in a separate process bounded by wall-clock time and (POSIX) address space.
PDF_EXTRACTION_TIMEOUT_SECONDS=120
PDF_EXTRACTION_MEMORY_LIMIT_MB=1024
PDF_MAX_CHARACTERS_PER_PAGE=1000000
PDF_MAX_TOTAL_CHARACTERS=20000000
# Chunking (§14), in tokens of the configured tokenizer: CHUNK_OVERLAP < CHUNK_SIZE and
# MIN_CHUNK_SIZE <= CHUNK_SIZE.
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_SIZE=64

# ---- Embeddings (§15, §38, §73) ----------------------------------------------------------
# fake: deterministic vectors for local development and tests (refused when deployed).
# openai: any OpenAI-compatible /embeddings endpoint (OpenAI, Azure OpenAI, Ollama, vLLM).
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=replace-with-the-provider-key (Secrets Manager when deployed)
# Per request: timeout, bounded exponential backoff (base * 2^n with jitter, capped).
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_ATTEMPTS=4
EMBEDDING_BACKOFF_BASE_SECONDS=0.5
EMBEDDING_BACKOFF_MAX_SECONDS=8
# Batching: inputs per request, characters per request, characters per input, requests in flight.
EMBEDDING_MAX_BATCH_SIZE=64
EMBEDDING_MAX_BATCH_CHARACTERS=200000
EMBEDDING_MAX_INPUT_CHARACTERS=32000
EMBEDDING_MAX_CONCURRENCY=4

# ---- Language model (§21, §38, §73) ------------------------------------------------------
# fake: deterministic answers for local development and tests (refused when deployed).
# openai: any OpenAI-compatible /chat/completions endpoint (OpenAI, Azure OpenAI, Ollama, vLLM).
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=replace-with-the-provider-key (Secrets Manager when deployed)
# Per request: timeout, bounded exponential backoff (base * 2^n with jitter, capped).
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE_SECONDS=1
LLM_BACKOFF_MAX_SECONDS=10
# Output budget per answer, sampling temperature (0 = deterministic where the provider allows),
# and the largest prompt accepted before any request is made.
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0
LLM_MAX_INPUT_CHARACTERS=200000

# ---- Document storage (§11, §53; docker/compose.yaml → minio) ----------------------------
# filesystem: originals under STORAGE_LOCAL_ROOT (no Docker needed); s3: AWS S3 or the local
# MinIO. Staging and production require s3 with encryption, an https endpoint (or none for
# AWS) and no static keys: the execution role provides credentials.
STORAGE_BACKEND=filesystem
STORAGE_LOCAL_ROOT=.local/storage
# STORAGE_BACKEND=s3
STORAGE_BUCKET=doculens-documents
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY_ID=doculens
STORAGE_SECRET_ACCESS_KEY=doculens-local-only
STORAGE_FORCE_PATH_STYLE=true
# none locally; AES256 (SSE-S3) or aws:kms with STORAGE_KMS_KEY_ID when deployed.
STORAGE_ENCRYPTION=none
# Deployed: the AWS account that must own the bucket (sent with every request), and the largest
# object the adapters accept on upload or read back (bytes).
# STORAGE_EXPECTED_BUCKET_OWNER=123456789012
STORAGE_MAX_OBJECT_BYTES=104857600
# MINIO_* configure the local container.
MINIO_ROOT_USER=doculens
MINIO_ROOT_PASSWORD=doculens-local-only
MINIO_PORT=9000
# Integration tests start a throwaway MinIO by default; point them at the compose one instead:
# DOCULENS_TEST_S3_ENDPOINT_URL=http://localhost:9000

# ---- Vector store (§16, §32; docker/compose.yaml → chroma) -------------------------------
# chroma is the required store; memory exists for unit tests only (refused when deployed).
VECTOR_STORE=chroma
CHROMA_PORT=8001
CHROMA_URL=http://localhost:8001
# CHROMA_API_TOKEN=replace-with-the-server-token (when the server enforces token auth)
# One collection per embedding model: <prefix>-<model slug>.
CHROMA_COLLECTION_PREFIX=doculens
CHROMA_TIMEOUT_SECONDS=10
VECTOR_SEARCH_MAX_RESULTS=100
# Chunks embedded and written to the index per window: bounds worker memory for large documents.
INDEXING_BATCH_CHUNKS=128
# Integration tests start a throwaway ChromaDB by default; point them at the compose one instead:
# DOCULENS_TEST_CHROMA_URL=http://localhost:8001

# ---- Retrieval and context assembly (§17, §18, §19, §20; ADR-016) -------------------------
# semantic (vectors only), keyword (PostgreSQL full-text search only) or hybrid (both, fused by
# reciprocal-rank fusion).
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_MAX_QUERY_CHARACTERS=2000
# Nearest vectors fetched per question before selection (must not exceed VECTOR_SEARCH_MAX_RESULTS).
RETRIEVAL_CANDIDATES=20
# Cosine similarity below which a semantic neighbour is not evidence (keyword matches are not
# thresholded); 0 keeps only non-negative matches.
RETRIEVAL_MIN_SCORE=0
RETRIEVAL_MAX_SCOPE_DOCUMENTS=100
# Wall-clock budget for embedding, vector and keyword search per question (retryable 503 on expiry).
RETRIEVAL_TIMEOUT_SECONDS=15
# Context handed to the model: at most this many chunks and characters, with per-document slots
# when several documents contribute (source diversity).
# Optional reranking (§19): none (off) or fake (deterministic word overlap; local and tests only).
# The top RETRIEVAL_CANDIDATES go in, RERANK_TOP_K come out; a slow or failing reranker falls
# back to the retrieval order within RERANK_TIMEOUT_SECONDS.
RERANKER_PROVIDER=none
# RERANK_MODEL=
RERANK_TOP_K=5
RERANK_TIMEOUT_SECONDS=5
CONTEXT_MAX_CHUNKS=5
CONTEXT_MAX_CHARACTERS=12000
CONTEXT_MAX_CHUNKS_PER_DOCUMENT=3
# Conversation turns carried into the grounded prompt (§25), newest first; bounded in count and size.
PROMPT_MAX_HISTORY_MESSAGES=10
PROMPT_MAX_HISTORY_CHARACTERS=8000
# Follow-up questions are rewritten into standalone queries by the LLM before retrieval (§26);
# a failed or slow rewrite falls back to the question as asked. Citations quote at most this
# many characters of the evidence (§23).
QUERY_REWRITING=true
QUERY_REWRITE_TIMEOUT_SECONDS=10
# Wall-clock budget for the answer's model call (retries included); a retryable 503 on expiry.
GENERATION_TIMEOUT_SECONDS=90
CITATION_MAX_QUOTE_CHARACTERS=500

# ---- Web (see apps/web/.env.example) -----------------------------------------------------
