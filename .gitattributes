# Normalise line endings to LF in the repository AND in every working tree, regardless of the
# developer's core.autocrlf setting. Prettier, ruff and the tool version files expect LF.
* text=auto eol=lf

# Windows-only files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never normalised
*.png binary
*.jpg binary
*.pdf binary
*.woff2 binary
