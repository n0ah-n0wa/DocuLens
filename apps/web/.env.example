# DocuLens web — local environment template. Copy to `.env.local` (git-ignored).
# Only NEXT_PUBLIC_* variables are exposed to the browser; never put secrets in them.

# Base URL of the DocuLens API (no trailing slash). Used by the central API client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Client-side upload size check; keep at or below the API MAX_FILE_SIZE_MB (default 50).
NEXT_PUBLIC_MAX_FILE_SIZE_MB=50

# How often to refresh document status while processing (milliseconds).
NEXT_PUBLIC_PROCESSING_POLL_MS=2500
