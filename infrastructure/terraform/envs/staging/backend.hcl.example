# Example backend configuration (git-ignored when copied to backend.hcl).
#
# Bootstrap once per AWS account via infrastructure/terraform/bootstrap/state
# (manual apply — not part of CD):
#   1. S3 bucket with versioning + SSE-KMS
#   2. DynamoDB lock table
#   3. Bucket policy denying non-TLS and public access
#   4. Separate state keys for staging vs production (already in backend.tf)
#
# Then:
#   cp backend.hcl.example backend.hcl
#   terraform init -backend-config=backend.hcl

bucket         = "doculens-terraform-state-ACCOUNT_ID"
region         = "eu-central-1"
dynamodb_table = "doculens-terraform-locks"
encrypt        = true
# Recommended: CMK from bootstrap/state output kms_key_arn (or TF_STATE_KMS_KEY_ID in CD):
# kms_key_id   = "arn:aws:kms:eu-central-1:ACCOUNT_ID:key/..."
