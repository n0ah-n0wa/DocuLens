aws_region = "eu-central-1"

# ChromaDB hosting is still open (OQ-1). Point at a reachable server before apply, or
# expect /health/ready to fail until CHROMA_URL is valid.
chroma_url = "https://chroma.example.internal:8000"

# Cost: staging keeps a single NAT and skips interface VPC endpoints by default.
enable_interface_endpoints = false
enable_vpc_flow_logs       = true

# GitHub Actions OIDC (§5.5): staging gets its own deploy role. The account-level OIDC
# provider is created once (usually in production). Leave create_github_oidc_provider
# false here after the provider exists; set github_repository to enable the role.
create_github_oidc_provider = false
create_github_deploy_role   = true
github_repository           = "n0ah-n0wa/DocuLens"
# github_oidc_provider_arn  = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
# Subjects default to: repo:n0ah-n0wa/DocuLens:environment:staging

# Set after the first image push, e.g.:
# api_image_uri    = "123456789012.dkr.ecr.eu-central-1.amazonaws.com/doculens-staging-api@sha256:..."
# worker_image_uri = "123456789012.dkr.ecr.eu-central-1.amazonaws.com/doculens-staging-worker@sha256:..."
